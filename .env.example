# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://postgres:password@localhost:5432/zsarra?schema=public"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin account (used only by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-strong-password"

# Cloudinary (product images). REQUIRED when the site is hosted (Netlify has no writable disk).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: protects /api/cron/expire-orders
CRON_SECRET=""
