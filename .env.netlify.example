# Used ONLY by `npm run db:prod` on your own computer to set up the production database. Never commit this file.
# Use the DIRECT (non-pooled) connection string from your database provider (for Neon: the one WITHOUT "-pooler" in the host).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxxxxx.region.aws.neon.tech/zsarra?sslmode=require"
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD="choose-a-long-unique-password"
